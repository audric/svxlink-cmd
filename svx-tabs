#!/usr/bin/env bash
set -uo pipefail

# --- Root check ---
if [[ $EUID -ne 0 ]]; then
    echo "Error: Must run as root (sudo ./svx-tabs)" >&2
    exit 1
fi

# --- Source shared library ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/svx-lib"

# --- Tab state ---
CURRENT_TAB=0
readonly TAB_NAMES=("OVERVIEW" "LOGS" "CONFIG" "MAINTENANCE")
readonly TAB_COUNT=${#TAB_NAMES[@]}

# --- Per-tab state ---
LOG_SERVICE="svxlink"
CONFIG_SEL=0
MAINT_SEL=0

# --- Title bar (row 0) ---
draw_title_bar() {
    move_to 0 0
    printf '%b%s%s ' "$C_ACCENT" "$BOX_TL" "$BOX_H"
    printf '%b%s v%s%b' "$C_ACCENT_BOLD" "$SVX_NAME" "$SVX_VERSION" "$C_ACCENT"
    printf ' %b──%b ' "$C_ACCENT" "$C_ACCENT"
    printf '%b%s%b' "$C_WHITE" "$SYS_HOST" "$C_ACCENT"
    printf ' %b──%b ' "$C_ACCENT" "$C_ACCENT"
    printf '%b%s%b' "$C_DIM" "$SYS_IP" "$C_ACCENT"
    local used=$(( ${#SVX_NAME} + ${#SVX_VERSION} + ${#SYS_HOST} + ${#SYS_IP} + 16 ))
    local fill=$((TERM_COLS - used - 1))
    (( fill > 0 )) && printf '%*s' "$fill" '' | tr ' ' "$BOX_H"
    printf '%s%b' "$BOX_TR" "$C_RESET"
}

# --- Status bar (row 1) ---
draw_status_bar() {
    move_to 1 0
    printf '%b%s%b ' "$C_ACCENT" "$BOX_V" "$C_RESET"

    if [[ -n "$SYS_TEMP" ]]; then
        local tc="$C_OK"
        (( SYS_TEMP >= 70 )) && tc="$C_WARN"
        (( SYS_TEMP >= 80 )) && tc="$C_ERR"
        printf '%bCPU:%b %b%s°C%b  ' "$C_DIM" "$C_RESET" "$tc" "$SYS_TEMP" "$C_RESET"
    fi
    [[ -n "$SYS_LOAD" ]] && printf '%bLoad:%b %s  ' "$C_DIM" "$C_RESET" "$SYS_LOAD"
    [[ -n "$SYS_UPTIME" ]] && printf '%bUp:%b %s  ' "$C_DIM" "$C_RESET" "$SYS_UPTIME"

    local svc_str=""
    local svc
    for svc in "${SERVICES[@]}"; do
        local status="${SVC_STATUS[$svc]:-unknown}"
        local label="${SERVICE_LABELS[$svc]}"
        local dot="○" color="$C_DIM"
        [[ "$status" == "active" ]] && dot="●" && color="$C_OK"
        [[ "$status" == "failed" ]] && dot="●" && color="$C_ERR"
        svc_str+="${color}${dot}${C_RESET} ${label}  "
    done
    local svc_plain_len=0
    for svc in "${SERVICES[@]}"; do
        svc_plain_len=$(( svc_plain_len + ${#SERVICE_LABELS[$svc]} + 4 ))
    done
    move_to 1 "$((TERM_COLS - svc_plain_len - 1))"
    printf '%b' "$svc_str"

    move_to 1 "$((TERM_COLS - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
}

# --- Separator (row 2) ---
draw_sep_2() {
    draw_hline 2 0 "$TERM_COLS"
}

# --- Tab bar (row 3) ---
draw_tab_bar() {
    move_to 3 0
    printf '%b%s%b  ' "$C_ACCENT" "$BOX_V" "$C_RESET"

    local i
    for (( i = 0; i < TAB_COUNT; i++ )); do
        if (( i == CURRENT_TAB )); then
            printf '%b[%s]%b  ' "$C_ACCENT_BOLD" "${TAB_NAMES[$i]}" "$C_RESET"
        else
            printf '%b %s %b  ' "$C_DIM" "${TAB_NAMES[$i]}" "$C_RESET"
        fi
    done

    move_to 3 "$((TERM_COLS - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"

    draw_hline 4 0 "$TERM_COLS"
}

# --- Content area ---
CONTENT_TOP=5
CONTENT_H=0

calc_content() {
    CONTENT_H=$((TERM_ROWS - CONTENT_TOP - 3))
    (( CONTENT_H < 5 )) && CONTENT_H=5
}

# --- Tab 0: Overview ---
draw_tab_overview() {
    local r=$CONTENT_TOP
    local mid=$((TERM_COLS / 2))

    draw_text "$r" 2 "${C_ACCENT_BOLD}SERVICES${C_RESET}"
    draw_text "$r" "$((mid + 1))" "${C_ACCENT_BOLD}SYSTEM${C_RESET}"
    draw_vline_segment "$CONTENT_TOP" "$mid" "$CONTENT_H"
    move_to 4 "$mid"
    printf '%b%s%b' "$C_ACCENT" "$BOX_TT" "$C_RESET"

    (( r++ ))
    local svc
    for svc in "${SERVICES[@]}"; do
        local status="${SVC_STATUS[$svc]:-unknown}"
        local label="${SERVICE_LABELS[$svc]}"
        local dot="○" color="$C_DIM"
        [[ "$status" == "active" ]] && dot="●" && color="$C_OK"
        [[ "$status" == "failed" ]] && dot="●" && color="$C_ERR"
        move_to "$r" 2
        printf '%b%s%b %-14s %b%s%b' "$color" "$dot" "$C_RESET" "$label" "$color" "$status" "$C_RESET"
        (( r++ ))
    done

    (( r++ ))
    local alabel="AUDIO"
    [[ -n "$USB_CARD" ]] && alabel="AUDIO (USB:${USB_CARD})"
    draw_text "$r" 2 "${C_ACCENT_BOLD}${alabel}${C_RESET}"
    (( r++ ))

    local bar_w=$((mid - 14))
    (( bar_w < 5 )) && bar_w=5

    if [[ -z "$USB_CARD" ]]; then
        draw_text "$r" 2 "${C_DIM}No USB audio${C_RESET}"
    else
        move_to "$r" 2
        printf '%bMic  %b' "$C_DIM" "$C_RESET"
        if [[ -n "$AUDIO_MIC" ]]; then
            draw_bar "$r" 8 "$bar_w" "$AUDIO_MIC"
        else
            printf '%b--%b' "$C_DIM" "$C_RESET"
        fi
        (( r++ ))

        move_to "$r" 2
        printf '%bSpkr %b' "$C_DIM" "$C_RESET"
        if [[ -n "$AUDIO_SPKR" ]]; then
            draw_bar "$r" 8 "$bar_w" "$AUDIO_SPKR"
        else
            printf '%b--%b' "$C_DIM" "$C_RESET"
        fi
        (( r++ ))

        move_to "$r" 2
        printf '%bAGC  %b' "$C_DIM" "$C_RESET"
        if [[ -z "$AUDIO_AGC" ]]; then
            printf '%b--%b' "$C_DIM" "$C_RESET"
        elif [[ "$AUDIO_AGC" == "off" ]]; then
            printf '%bOFF%b' "$C_OK" "$C_RESET"
        else
            printf '%bON%b' "$C_WARN" "$C_RESET"
        fi
    fi

    r=$((CONTENT_TOP + 1))
    local rc=$((mid + 1))
    local rbar_w=$((TERM_COLS - mid - 22))
    (( rbar_w < 5 )) && rbar_w=5

    local line
    for line in "${DISK_LINES[@]}"; do
        local mount size used avail pct
        read -r mount size used avail pct <<< "$line"
        move_to "$r" "$rc"
        printf '%-6s %b%s/%s%b ' "$mount" "$C_DIM" "$used" "$size" "$C_RESET"
        draw_bar "$r" "$((rc + 18))" "$rbar_w" "$pct"
        (( r++ ))
    done

    if [[ ${#USB_LINES[@]} -gt 0 ]]; then
        (( r++ ))
        draw_text "$r" "$rc" "${C_ACCENT_BOLD}USB${C_RESET}"
        (( r++ ))
        for line in "${USB_LINES[@]}"; do
            local mount size used avail pct
            read -r mount size used avail pct <<< "$line"
            move_to "$r" "$rc"
            printf '%-10s %b%s/%s%b' "$mount" "$C_DIM" "$used" "$size" "$C_RESET"
            (( r++ ))
        done
    fi

    (( r++ ))
    draw_text "$r" "$rc" "${C_ACCENT_BOLD}TOP PROCS${C_RESET}"
    (( r++ ))
    for line in "${TOP_LINES[@]}"; do
        local comm cpu mem
        read -r comm cpu mem <<< "$line"
        move_to "$r" "$rc"
        printf '%-12s %b%5s%%%b' "$comm" "$C_DIM" "$cpu" "$C_RESET"
        (( r++ ))
    done

    local j
    for (( j = CONTENT_TOP; j < CONTENT_TOP + CONTENT_H; j++ )); do
        move_to "$j" 0
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        move_to "$j" "$((TERM_COLS - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done
}

# --- Tab 1: Logs ---
draw_tab_logs() {
    local r=$CONTENT_TOP
    local inner_w=$((TERM_COLS - 4))

    move_to "$r" 2
    printf '%bLOGS%b (%b%s%b)' "$C_ACCENT_BOLD" "$C_RESET" "$C_WHITE" "${SERVICE_LABELS[$LOG_SERVICE]}" "$C_RESET"
    local hint="◀ ▶ switch service"
    move_to "$r" "$((TERM_COLS - ${#hint} - 2))"
    printf '%b%s%b' "$C_DIM" "$hint" "$C_RESET"
    (( r++ ))

    collect_logs "$((CONTENT_H - 1))"
    local i
    for (( i = 0; i < CONTENT_H - 1; i++ )); do
        move_to "$r" 2
        if (( i < ${#LOG_LINES[@]} )); then
            draw_text_trunc "$r" 2 "$inner_w" "${LOG_LINES[$i]}"
        fi
        (( r++ ))
    done

    local j
    for (( j = CONTENT_TOP; j < CONTENT_TOP + CONTENT_H; j++ )); do
        move_to "$j" 0
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        move_to "$j" "$((TERM_COLS - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done
}

# --- Tab 2: Config ---
CONFIG_ITEMS=()
CONFIG_PATHS=()

build_config_list() {
    CONFIG_ITEMS=()
    CONFIG_PATHS=()
    local svc
    for svc in "${SERVICES[@]}"; do
        CONFIG_ITEMS+=("${SERVICE_LABELS[$svc]} config")
        CONFIG_PATHS+=("${CONFIG_FILES[$svc]}")
    done
    CONFIG_ITEMS+=("GPIO config")
    CONFIG_PATHS+=("$GPIO_CONF")
    for svc in "${SERVICES[@]}"; do
        CONFIG_ITEMS+=("${SERVICE_LABELS[$svc]} env")
        CONFIG_PATHS+=("${ENV_FILES[$svc]}")
    done
}

draw_tab_config() {
    build_config_list
    local r=$CONTENT_TOP
    draw_text "$r" 2 "${C_ACCENT_BOLD}CONFIG FILES${C_RESET}  ${C_DIM}(Enter to edit, Up/Down to select)${C_RESET}"
    (( r += 2 ))

    local i
    for (( i = 0; i < ${#CONFIG_ITEMS[@]}; i++ )); do
        move_to "$r" 2
        if (( i == CONFIG_SEL )); then
            printf '%b▸ %-24s%b %b%s%b' "$C_ACCENT_BOLD" "${CONFIG_ITEMS[$i]}" "$C_RESET" \
                "$C_DIM" "${CONFIG_PATHS[$i]}" "$C_RESET"
        else
            local exists_color="$C_DIM"
            [[ -f "${CONFIG_PATHS[$i]}" ]] && exists_color="$C_RESET"
            printf '  %b%-24s%b %b%s%b' "$exists_color" "${CONFIG_ITEMS[$i]}" "$C_RESET" \
                "$C_DIM" "${CONFIG_PATHS[$i]}" "$C_RESET"
        fi
        (( r++ ))
    done

    local j
    for (( j = CONTENT_TOP; j < CONTENT_TOP + CONTENT_H; j++ )); do
        move_to "$j" 0
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        move_to "$j" "$((TERM_COLS - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done
}

# --- Tab 3: Maintenance ---
MAINT_ITEMS=("Log rotation check" "GPIO restart" "Enable service at boot" "Disable service at boot")

draw_tab_maintenance() {
    local r=$CONTENT_TOP
    draw_text "$r" 2 "${C_ACCENT_BOLD}MAINTENANCE${C_RESET}  ${C_DIM}(Enter to execute)${C_RESET}"
    (( r += 2 ))

    local i
    for (( i = 0; i < ${#MAINT_ITEMS[@]}; i++ )); do
        move_to "$r" 2
        if (( i == MAINT_SEL )); then
            printf '%b▸ %s%b' "$C_ACCENT_BOLD" "${MAINT_ITEMS[$i]}" "$C_RESET"
        else
            printf '  %s' "${MAINT_ITEMS[$i]}"
        fi
        (( r++ ))
    done

    local j
    for (( j = CONTENT_TOP; j < CONTENT_TOP + CONTENT_H; j++ )); do
        move_to "$j" 0
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        move_to "$j" "$((TERM_COLS - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done
}

# --- Hotkey bar ---
draw_hotkey_bar() {
    local r=$((TERM_ROWS - 2))
    draw_hline "$((r - 1))" 0 "$TERM_COLS"

    move_to "$r" 0
    printf '%b%s%b ' "$C_ACCENT" "$BOX_V" "$C_RESET"

    case $CURRENT_TAB in
        0)
            printf 's%b[T]%bart ' "$C_ACCENT_BOLD" "$C_RESET"
            printf '%b[S]%btop ' "$C_ACCENT_BOLD" "$C_RESET"
            printf '%b[R]%bestart ' "$C_ACCENT_BOLD" "$C_RESET"
            printf 're%b[L]%boad ' "$C_ACCENT_BOLD" "$C_RESET"
            printf '%b[A]%blsa' "$C_ACCENT_BOLD" "$C_RESET"
            ;;
        1)
            printf '%b◀ ▶%b switch service' "$C_ACCENT_BOLD" "$C_RESET"
            ;;
        2)
            printf '%b↑ ↓%b select  %b⏎%b edit' "$C_ACCENT_BOLD" "$C_RESET" "$C_ACCENT_BOLD" "$C_RESET"
            ;;
        3)
            printf '%b↑ ↓%b select  %b⏎%b execute' "$C_ACCENT_BOLD" "$C_RESET" "$C_ACCENT_BOLD" "$C_RESET"
            ;;
    esac

    move_to "$r" "$((TERM_COLS - 20))"
    printf '%b[1-4]%b Tab  %b[Q]%b' "$C_ACCENT_BOLD" "$C_RESET" "$C_ACCENT_BOLD" "$C_RESET"
    move_to "$r" "$((TERM_COLS - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"

    move_to "$((TERM_ROWS - 1))" 0
    printf '%b%s' "$C_ACCENT" "$BOX_BL"
    printf '%*s' "$((TERM_COLS - 2))" '' | tr ' ' "$BOX_H"
    printf '%s%b' "$BOX_BR" "$C_RESET"
}

draw_tab_content() {
    case $CURRENT_TAB in
        0) draw_tab_overview ;;
        1) draw_tab_logs ;;
        2) draw_tab_config ;;
        3) draw_tab_maintenance ;;
    esac
}

# --- Full redraw ---
draw_all() {
    clear
    calc_content
    refresh_all_data
    draw_title_bar
    draw_status_bar
    draw_sep_2
    draw_tab_bar
    draw_tab_content
    draw_hotkey_bar
    NEEDS_REDRAW=0
}

# --- Handle keys ---
handle_key() {
    case "$READ_KEY_RESULT" in
        tab) CURRENT_TAB=$(( (CURRENT_TAB + 1) % TAB_COUNT )); NEEDS_REDRAW=1 ;;
        shift_tab) CURRENT_TAB=$(( (CURRENT_TAB - 1 + TAB_COUNT) % TAB_COUNT )); NEEDS_REDRAW=1 ;;
        1) CURRENT_TAB=0; NEEDS_REDRAW=1 ;;
        2) CURRENT_TAB=1; NEEDS_REDRAW=1 ;;
        3) CURRENT_TAB=2; NEEDS_REDRAW=1 ;;
        4) CURRENT_TAB=3; NEEDS_REDRAW=1 ;;

        up)
            case $CURRENT_TAB in
                2) (( CONFIG_SEL > 0 )) && (( CONFIG_SEL-- )); NEEDS_REDRAW=1 ;;
                3) (( MAINT_SEL > 0 )) && (( MAINT_SEL-- )); NEEDS_REDRAW=1 ;;
            esac
            ;;
        down)
            case $CURRENT_TAB in
                2) build_config_list; (( CONFIG_SEL < ${#CONFIG_ITEMS[@]} - 1 )) && (( CONFIG_SEL++ )); NEEDS_REDRAW=1 ;;
                3) (( MAINT_SEL < ${#MAINT_ITEMS[@]} - 1 )) && (( MAINT_SEL++ )); NEEDS_REDRAW=1 ;;
            esac
            ;;
        left)
            if (( CURRENT_TAB == 1 )); then
                local idx=0 i
                for (( i = 0; i < ${#SERVICES[@]}; i++ )); do
                    [[ "${SERVICES[$i]}" == "$LOG_SERVICE" ]] && idx=$i && break
                done
                (( idx > 0 )) && LOG_SERVICE="${SERVICES[$((idx - 1))]}"
                NEEDS_REDRAW=1
            fi
            ;;
        right)
            if (( CURRENT_TAB == 1 )); then
                local idx=0 i
                for (( i = 0; i < ${#SERVICES[@]}; i++ )); do
                    [[ "${SERVICES[$i]}" == "$LOG_SERVICE" ]] && idx=$i && break
                done
                (( idx < ${#SERVICES[@]} - 1 )) && LOG_SERVICE="${SERVICES[$((idx + 1))]}"
                NEEDS_REDRAW=1
            fi
            ;;
        enter)
            case $CURRENT_TAB in
                2)
                    build_config_list
                    local path="${CONFIG_PATHS[$CONFIG_SEL]}"
                    if [[ -f "$path" ]]; then
                        exit_tui
                        $EDITOR "$path"
                        enter_tui
                        NEEDS_REDRAW=1
                    else
                        show_message "Error" "File not found: $path"
                        NEEDS_REDRAW=1
                    fi
                    ;;
                3)
                    case $MAINT_SEL in
                        0) action_check_logrotate ;;
                        1) action_gpio_restart ;;
                        2) action_enable ;;
                        3) action_disable ;;
                    esac
                    NEEDS_REDRAW=1
                    ;;
            esac
            ;;

        t) (( CURRENT_TAB == 0 )) && action_start && NEEDS_REDRAW=1 ;;
        s) (( CURRENT_TAB == 0 )) && action_stop && NEEDS_REDRAW=1 ;;
        r) (( CURRENT_TAB == 0 )) && action_restart && NEEDS_REDRAW=1 ;;
        l) (( CURRENT_TAB == 0 )) && action_reload && NEEDS_REDRAW=1 ;;
        a) (( CURRENT_TAB == 0 )) && action_alsamixer ;;

        q|Q) exit_tui; echo "Goodbye!"; exit 0 ;;
    esac
}

# --- Terminal size check ---
check_min_size() {
    if (( TERM_COLS < 80 || TERM_ROWS < 24 )); then
        clear
        move_to "$((TERM_ROWS / 2))" "$(( (TERM_COLS - 30) / 2 ))"
        printf '%bTerminal too small (need 80x24)%b' "$C_WARN" "$C_RESET"
        read_key 0
        return 1
    fi
    return 0
}

# --- Main ---
detect_usb_card
enter_tui

while true; do
    get_term_size
    if check_min_size; then
        if (( NEEDS_REDRAW )); then
            draw_all
        else
            refresh_all_data
            draw_status_bar
            if (( CURRENT_TAB <= 1 )); then
                clear_region "$CONTENT_TOP" 1 "$((TERM_COLS - 2))" "$CONTENT_H"
                draw_tab_content
            fi
        fi
    fi
    read_key 3
    [[ "$READ_KEY_RESULT" != "timeout" ]] && handle_key
done
