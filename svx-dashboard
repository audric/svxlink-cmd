#!/usr/bin/env bash
set -uo pipefail

# --- Root check ---
if [[ $EUID -ne 0 ]]; then
    echo "Error: Must run as root (sudo ./svx-dashboard)" >&2
    exit 1
fi

# --- Source shared library ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/svx-lib"

# --- State ---
LOG_SERVICE="svxlink"

# --- Draw title bar (row 0) ---
draw_title_bar() {
    local row=0
    move_to "$row" 0
    printf '%b%s%s ' "$C_ACCENT" "$BOX_TL" "$BOX_H"
    printf '%b%s v%s%b' "$C_ACCENT_BOLD" "$SVX_NAME" "$SVX_VERSION" "$C_ACCENT"
    printf ' %b──%b ' "$C_ACCENT" "$C_ACCENT"
    printf '%b%s%b' "$C_WHITE" "$SYS_HOST" "$C_ACCENT"
    printf ' %b──%b ' "$C_ACCENT" "$C_ACCENT"
    printf '%b%s%b' "$C_DIM" "$SYS_IP" "$C_ACCENT"
    local used=0
    used=$(( ${#SVX_NAME} + ${#SVX_VERSION} + ${#SYS_HOST} + ${#SYS_IP} + 14 ))
    local fill=$((TERM_COLS - used - 1))
    (( fill > 0 )) && printf '%*s' "$fill" '' | tr ' ' "$BOX_H"
    printf '%s%b' "$BOX_TR" "$C_RESET"
}

# --- Draw sysinfo bar (row 1) ---
draw_sysinfo_bar() {
    local row=1
    move_to "$row" 0
    printf '%b%s%b ' "$C_ACCENT" "$BOX_V" "$C_RESET"

    if [[ -n "$SYS_TEMP" ]]; then
        local tc="$C_OK"
        (( SYS_TEMP >= 70 )) && tc="$C_WARN"
        (( SYS_TEMP >= 80 )) && tc="$C_ERR"
        printf '%bCPU:%b %b%s°C%b   ' "$C_DIM" "$C_RESET" "$tc" "$SYS_TEMP" "$C_RESET"
    fi

    [[ -n "$SYS_LOAD" ]] && printf '%bLoad:%b %s   ' "$C_DIM" "$C_RESET" "$SYS_LOAD"
    [[ -n "$SYS_UPTIME" ]] && printf '%bUp:%b %s' "$C_DIM" "$C_RESET" "$SYS_UPTIME"

    move_to "$row" "$((TERM_COLS - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
}

# --- Column layout calculations ---
COL1_X=1
COL1_W=0
COL2_X=0
COL2_W=0
COL3_X=0
COL3_W=0
PANEL_TOP=3
PANEL_H=10

calc_layout() {
    COL1_W=$(( (TERM_COLS - 2) * 33 / 100 ))
    COL2_W=$(( (TERM_COLS - 2) * 25 / 100 ))
    COL3_W=$(( TERM_COLS - 2 - COL1_W - COL2_W ))
    COL2_X=$((COL1_X + COL1_W))
    COL3_X=$((COL2_X + COL2_W))
    PANEL_H=10
}

draw_panel_separator() {
    draw_hline 2 0 "$TERM_COLS"
}

draw_col_separators() {
    local i
    for (( i = PANEL_TOP; i < PANEL_TOP + PANEL_H; i++ )); do
        move_to "$i" "$((COL2_X - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        move_to "$i" "$((COL3_X - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done
    for (( i = PANEL_TOP; i < PANEL_TOP + PANEL_H; i++ )); do
        move_to "$i" 0
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        move_to "$i" "$((TERM_COLS - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done
    move_to 2 "$((COL2_X - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_TT" "$C_RESET"
    move_to 2 "$((COL3_X - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_TT" "$C_RESET"
}

draw_services_panel() {
    local r=$PANEL_TOP c=$COL1_X
    draw_text "$r" "$c" "${C_ACCENT_BOLD}SERVICES${C_RESET}"
    (( r++ ))
    local svc
    for svc in "${SERVICES[@]}"; do
        local status="${SVC_STATUS[$svc]:-unknown}"
        local label="${SERVICE_LABELS[$svc]}"
        local dot="○" color="$C_DIM"
        [[ "$status" == "active" ]] && dot="●" && color="$C_OK"
        [[ "$status" == "failed" ]] && dot="●" && color="$C_ERR"
        move_to "$r" "$c"
        printf '%b%s%b %-12s %b%s%b' "$color" "$dot" "$C_RESET" "$label" "$color" "$status" "$C_RESET"
        (( r++ ))
    done
}

draw_top_panel() {
    local r=$((PANEL_TOP + 5)) c=$COL1_X
    draw_text "$r" "$c" "${C_ACCENT_BOLD}TOP PROCS${C_RESET}"
    (( r++ ))
    local line
    for line in "${TOP_LINES[@]}"; do
        local comm cpu mem
        read -r comm cpu mem <<< "$line"
        move_to "$r" "$c"
        printf '%-10s %b%5s%%%b' "$comm" "$C_DIM" "$cpu" "$C_RESET"
        (( r++ ))
        (( r >= PANEL_TOP + PANEL_H )) && break
    done
}

draw_audio_panel() {
    local r=$PANEL_TOP c=$COL2_X
    local label="AUDIO"
    [[ -n "$USB_CARD" ]] && label="AUDIO (USB:${USB_CARD})"
    draw_text "$r" "$c" "${C_ACCENT_BOLD}${label}${C_RESET}"
    (( r++ ))

    if [[ -z "$USB_CARD" ]]; then
        draw_text "$r" "$c" "${C_DIM}No USB audio${C_RESET}"
        return
    fi

    local bar_w=$((COL2_W - 12))
    (( bar_w < 5 )) && bar_w=5

    move_to "$r" "$c"
    printf '%bMic  %b' "$C_DIM" "$C_RESET"
    if [[ -n "$AUDIO_MIC" ]]; then
        draw_bar "$r" "$((c + 6))" "$bar_w" "$AUDIO_MIC"
    else
        draw_text "$r" "$((c + 6))" "${C_DIM}--${C_RESET}"
    fi
    (( r++ ))

    move_to "$r" "$c"
    printf '%bSpkr %b' "$C_DIM" "$C_RESET"
    if [[ -n "$AUDIO_SPKR" ]]; then
        draw_bar "$r" "$((c + 6))" "$bar_w" "$AUDIO_SPKR"
    else
        draw_text "$r" "$((c + 6))" "${C_DIM}--${C_RESET}"
    fi
    (( r++ ))

    move_to "$r" "$c"
    printf '%bAGC  %b' "$C_DIM" "$C_RESET"
    if [[ -z "$AUDIO_AGC" ]]; then
        printf '%b--%b' "$C_DIM" "$C_RESET"
    elif [[ "$AUDIO_AGC" == "off" ]]; then
        printf '%bOFF %b' "$C_OK" "$C_RESET"
    else
        printf '%bON %b' "$C_WARN" "$C_RESET"
    fi
}

draw_disk_panel() {
    local r=$PANEL_TOP c=$COL3_X
    draw_text "$r" "$c" "${C_ACCENT_BOLD}DISK${C_RESET}"
    (( r++ ))

    local bar_w=$((COL3_W - 22))
    (( bar_w < 5 )) && bar_w=5

    local line
    for line in "${DISK_LINES[@]}"; do
        local mount size used avail pct
        read -r mount size used avail pct <<< "$line"
        move_to "$r" "$c"
        printf '%-6s %b%s/%s%b ' "$mount" "$C_DIM" "$used" "$size" "$C_RESET"
        draw_bar "$r" "$((c + 18))" "$bar_w" "$pct"
        (( r++ ))
    done

    if [[ ${#USB_LINES[@]} -gt 0 ]]; then
        (( r++ ))
        draw_text "$r" "$c" "${C_ACCENT_BOLD}USB${C_RESET}"
        (( r++ ))
        for line in "${USB_LINES[@]}"; do
            local mount size used avail pct
            read -r mount size used avail pct <<< "$line"
            move_to "$r" "$c"
            printf '%-10s %b%s/%s%b' "$mount" "$C_DIM" "$used" "$size" "$C_RESET"
            (( r++ ))
            (( r >= PANEL_TOP + PANEL_H )) && break
        done
    fi
}

# --- Log panel ---
LOG_TOP=0
LOG_H=0

calc_log_layout() {
    LOG_TOP=$((PANEL_TOP + PANEL_H + 1))
    LOG_H=$((TERM_ROWS - LOG_TOP - 3))
    (( LOG_H < 3 )) && LOG_H=3
}

draw_log_separator() {
    draw_hline "$((LOG_TOP - 1))" 0 "$TERM_COLS"
    move_to "$((LOG_TOP - 1))" "$((COL2_X - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_BT" "$C_RESET"
    move_to "$((LOG_TOP - 1))" "$((COL3_X - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_BT" "$C_RESET"
}

draw_log_panel() {
    local r=$LOG_TOP
    local inner_w=$((TERM_COLS - 4))

    move_to "$r" 0
    printf '%b%s%b ' "$C_ACCENT" "$BOX_V" "$C_RESET"
    printf '%bLOGS%b (%b%s%b)' "$C_ACCENT_BOLD" "$C_RESET" "$C_WHITE" "${SERVICE_LABELS[$LOG_SERVICE]}" "$C_RESET"
    local hint="◀ ▶ svc"
    move_to "$r" "$((TERM_COLS - ${#hint} - 2))"
    printf '%b%s%b' "$C_DIM" "$hint" "$C_RESET"
    move_to "$r" "$((TERM_COLS - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    (( r++ ))

    collect_logs "$((LOG_H - 1))"
    local i
    for (( i = 0; i < LOG_H - 1; i++ )); do
        move_to "$r" 0
        printf '%b%s%b ' "$C_ACCENT" "$BOX_V" "$C_RESET"
        if (( i < ${#LOG_LINES[@]} )); then
            draw_text_trunc "$r" 2 "$inner_w" "${LOG_LINES[$i]}"
        fi
        move_to "$r" "$((TERM_COLS - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        (( r++ ))
    done
}

# --- Hotkey bar ---
draw_hotkey_bar() {
    local r=$((TERM_ROWS - 2))
    draw_hline "$((r - 1))" 0 "$TERM_COLS"

    move_to "$r" 0
    printf '%b%s%b ' "$C_ACCENT" "$BOX_V" "$C_RESET"
    printf '%b[T]%bart ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[S]%btop ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[R]%bestart ' "$C_ACCENT_BOLD" "$C_RESET"
    printf 're%b[L]%boad ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[C]%bonf ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[G]%bPIO ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[E]%bnv ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[A]%blsa ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[H]%blth ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[B]%boot ' "$C_ACCENT_BOLD" "$C_RESET"
    printf '%b[D]%bisable' "$C_ACCENT_BOLD" "$C_RESET"

    move_to "$r" "$((TERM_COLS - 4))"
    printf '%b[Q]%b' "$C_ACCENT_BOLD" "$C_RESET"
    move_to "$r" "$((TERM_COLS - 1))"
    printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"

    local bottom=$((TERM_ROWS - 1))
    move_to "$bottom" 0
    printf '%b%s' "$C_ACCENT" "$BOX_BL"
    printf '%*s' "$((TERM_COLS - 2))" '' | tr ' ' "$BOX_H"
    printf '%s%b' "$BOX_BR" "$C_RESET"
}

# --- Full redraw ---
draw_all() {
    clear
    calc_layout
    calc_log_layout
    refresh_all_data
    draw_title_bar
    draw_sysinfo_bar
    draw_panel_separator
    draw_col_separators
    draw_services_panel
    draw_top_panel
    draw_audio_panel
    draw_disk_panel
    draw_log_separator
    draw_log_panel
    draw_hotkey_bar
    NEEDS_REDRAW=0
}

# --- Handle hotkeys ---
handle_key() {
    case "$READ_KEY_RESULT" in
        left)
            local idx=0 i
            for (( i = 0; i < ${#SERVICES[@]}; i++ )); do
                [[ "${SERVICES[$i]}" == "$LOG_SERVICE" ]] && idx=$i && break
            done
            (( idx > 0 )) && LOG_SERVICE="${SERVICES[$((idx - 1))]}"
            NEEDS_REDRAW=1
            ;;
        right)
            local idx=0 i
            for (( i = 0; i < ${#SERVICES[@]}; i++ )); do
                [[ "${SERVICES[$i]}" == "$LOG_SERVICE" ]] && idx=$i && break
            done
            (( idx < ${#SERVICES[@]} - 1 )) && LOG_SERVICE="${SERVICES[$((idx + 1))]}"
            NEEDS_REDRAW=1
            ;;
        t) action_start;   NEEDS_REDRAW=1 ;;
        s) action_stop;    NEEDS_REDRAW=1 ;;
        r) action_restart; NEEDS_REDRAW=1 ;;
        l) action_reload;  NEEDS_REDRAW=1 ;;
        c) action_edit_config ;;
        g) action_edit_gpio ;;
        e) action_edit_env ;;
        a) action_alsamixer ;;
        h) action_health_check ;;
        b) action_enable;  NEEDS_REDRAW=1 ;;
        d) action_disable; NEEDS_REDRAW=1 ;;
        q|Q) exit_tui; echo "Goodbye!"; exit 0 ;;
    esac
}

# --- Terminal size check ---
check_min_size() {
    if (( TERM_COLS < 80 || TERM_ROWS < 24 )); then
        clear
        move_to "$((TERM_ROWS / 2))" "$(( (TERM_COLS - 30) / 2 ))"
        printf '%bTerminal too small (need 80x24)%b' "$C_WARN" "$C_RESET"
        read_key 300
        return 1
    fi
    return 0
}

# --- Main ---
detect_usb_card
enter_tui

while true; do
    get_term_size
    if check_min_size; then
        if (( NEEDS_REDRAW )); then
            draw_all
        else
            refresh_all_data
            draw_sysinfo_bar
            draw_services_panel
            draw_top_panel
            draw_audio_panel
            draw_disk_panel
            draw_log_panel
        fi
    fi
    read_key 3
    [[ "$READ_KEY_RESULT" != "timeout" ]] && handle_key
done
