#!/usr/bin/env bash
# svx-lib — Shared library for Svx Admin TUI
# Source this file; do not execute directly.

[[ -n "${_SVX_LIB_LOADED:-}" ]] && return 0
readonly _SVX_LIB_LOADED=1

readonly SVX_VERSION="2.0.0"
readonly SVX_NAME="Svx Admin"

# --- Colors (ANSI) ---
C_RESET=$'\e[0m'
C_BOLD=$'\e[1m'
C_DIM=$'\e[90m'
C_ACCENT=$'\e[36m'        # Cyan
C_ACCENT_BOLD=$'\e[1;36m' # Bold cyan
C_OK=$'\e[32m'             # Green
C_ERR=$'\e[31m'            # Red
C_WARN=$'\e[33m'           # Yellow
C_BAR=$'\e[36m'            # Cyan fill
C_BAR_BG=$'\e[90m'         # Dark gray empty
C_WHITE=$'\e[97m'          # Bright white
C_BG=$'\e[40m'             # Black background

# --- Box-drawing characters ---
BOX_TL='┌' BOX_TR='┐' BOX_BL='└' BOX_BR='┘'
BOX_H='─' BOX_V='│'
BOX_LT='├' BOX_RT='┤' BOX_TT='┬' BOX_BT='┴' BOX_CROSS='┼'

# --- Service maps ---
readonly SERVICES=("svxlink" "remotetrx" "svxreflector")

declare -A SERVICE_LABELS=(
    [svxlink]="SvxLink"
    [remotetrx]="RemoteTRX"
    [svxreflector]="SvxReflector"
)

declare -A CONFIG_FILES=(
    [svxlink]="/etc/svxlink/svxlink.conf"
    [remotetrx]="/etc/svxlink/remotetrx.conf"
    [svxreflector]="/etc/svxlink/svxreflector.conf"
)

declare -A ENV_FILES=(
    [svxlink]="/etc/default/svxlink"
    [remotetrx]="/etc/default/remotetrx"
    [svxreflector]="/etc/default/svxreflector"
)

declare -A LOG_FILES=(
    [svxlink]="/var/log/svxlink"
    [remotetrx]="/var/log/remotetrx"
    [svxreflector]="/var/log/svxreflector"
)

readonly GPIO_CONF="/etc/svxlink/gpio.conf"
readonly LOGROTATE_CONF="/etc/logrotate.d/svxlink"

# --- Editor detection ---
EDITOR="${EDITOR:-$(command -v nano || command -v vi || echo "vi")}"

# --- Terminal state ---
TERM_ROWS=0
TERM_COLS=0
SAVED_STTY=""

get_term_size() {
    TERM_ROWS=$(tput lines 2>/dev/null || echo 24)
    TERM_COLS=$(tput cols 2>/dev/null || echo 80)
}

enter_tui() {
    tput smcup          # Alternate screen buffer
    tput civis          # Hide cursor
    SAVED_STTY=$(stty -g 2>/dev/null || true)
    stty -echo -icanon  # Raw mode
    printf '%b' "\e[?7l" # Disable line wrap
    clear
    get_term_size
    trap 'handle_resize' WINCH
    trap 'exit_tui; exit 0' INT TERM
}

exit_tui() {
    printf '%b' "\e[?7h"  # Re-enable line wrap
    [[ -n "$SAVED_STTY" ]] && stty "$SAVED_STTY" 2>/dev/null || stty echo icanon
    tput cnorm             # Show cursor
    tput rmcup             # Restore screen (last)
}

NEEDS_REDRAW=1

handle_resize() {
    get_term_size
    NEEDS_REDRAW=1
}

# --- Input handling ---
# Reads one keypress. Returns normalized key name in READ_KEY_RESULT.
# Times out after $1 seconds (default 3), returns "timeout".
READ_KEY_RESULT=""

read_key() {
    local timeout="${1:-3}"
    local _discard
    READ_KEY_RESULT=""
    local c
    if ! IFS= read -rsn1 -t "$timeout" c; then
        READ_KEY_RESULT="timeout"
        return
    fi
    if [[ "$c" == $'\e' ]]; then
        local seq
        IFS= read -rsn2 -t 0.1 seq || true
        case "$seq" in
            '[A') READ_KEY_RESULT="up" ;;
            '[B') READ_KEY_RESULT="down" ;;
            '[C') READ_KEY_RESULT="right" ;;
            '[D') READ_KEY_RESULT="left" ;;
            '[Z') READ_KEY_RESULT="shift_tab" ;;
            '[5') IFS= read -rsn1 -t 0.1 _discard || true; READ_KEY_RESULT="pgup" ;;
            '[6') IFS= read -rsn1 -t 0.1 _discard || true; READ_KEY_RESULT="pgdn" ;;
            '[H') READ_KEY_RESULT="home" ;;
            '[F') READ_KEY_RESULT="end" ;;
            *)    READ_KEY_RESULT="esc" ;;
        esac
    elif [[ "$c" == $'\t' ]]; then
        READ_KEY_RESULT="tab"
    elif [[ "$c" == "" ]]; then
        READ_KEY_RESULT="enter"
    elif [[ "$c" == $'\x7f' ]] || [[ "$c" == $'\b' ]]; then
        READ_KEY_RESULT="backspace"
    else
        READ_KEY_RESULT="$c"
    fi
}

# --- Drawing primitives ---

# Repeat a (possibly multi-byte) character N times.
# Usage: repeat_char CHAR COUNT
# tr can't handle multi-byte UTF-8, so we use a loop.
repeat_char() {
    local ch="$1" n="$2" i
    for (( i = 0; i < n; i++ )); do printf '%s' "$ch"; done
}

move_to() {
    printf '\e[%d;%dH' "$(($1 + 1))" "$(($2 + 1))"
}

draw_text() {
    local row=$1 col=$2
    shift 2
    move_to "$row" "$col"
    printf '%s' "$*"
}

draw_text_trunc() {
    local row=$1 col=$2 max_w=$3
    shift 3
    local text="$*"
    if (( ${#text} > max_w )); then
        text="${text:0:$((max_w - 1))}~"
    fi
    move_to "$row" "$col"
    printf '%s' "$text"
}

draw_box() {
    local row=$1 col=$2 w=$3 h=$4 title="${5:-}"
    local inner_w=$((w - 2))

    move_to "$row" "$col"
    printf '%b%s' "$C_ACCENT" "$BOX_TL"
    if [[ -n "$title" ]]; then
        printf '%s' "$BOX_H "
        printf '%b%s%b' "$C_ACCENT_BOLD" "$title" "$C_ACCENT"
        local title_len=$(( ${#title} + 3 ))
        local fill=$((inner_w - title_len))
        printf ' %s' "$(repeat_char "$BOX_H" "$fill")"
    else
        printf '%s' "$(repeat_char "$BOX_H" "$inner_w")"
    fi
    printf '%s%b' "$BOX_TR" "$C_RESET"

    local i
    for (( i = 1; i < h - 1; i++ )); do
        move_to "$((row + i))" "$col"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
        move_to "$((row + i))" "$((col + w - 1))"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done

    move_to "$((row + h - 1))" "$col"
    printf '%b%s%s%s%b' "$C_ACCENT" "$BOX_BL" \
        "$(repeat_char "$BOX_H" "$inner_w")" \
        "$BOX_BR" "$C_RESET"
}

draw_hline() {
    local row=$1 col=$2 w=$3
    local inner_w=$((w - 2))
    move_to "$row" "$col"
    printf '%b%s%s%s%b' "$C_ACCENT" "$BOX_LT" \
        "$(repeat_char "$BOX_H" "$inner_w")" \
        "$BOX_RT" "$C_RESET"
}

draw_vline_segment() {
    local row=$1 col=$2 h=$3
    local i
    for (( i = 0; i < h; i++ )); do
        move_to "$((row + i))" "$col"
        printf '%b%s%b' "$C_ACCENT" "$BOX_V" "$C_RESET"
    done
}

clear_region() {
    local row=$1 col=$2 w=$3 h=$4
    local blank
    blank=$(printf '%*s' "$w" '')
    local i
    for (( i = 0; i < h; i++ )); do
        move_to "$((row + i))" "$col"
        printf '%s' "$blank"
    done
}

draw_bar() {
    local row=$1 col=$2 w=$3 pct=$4
    (( pct > 100 )) && pct=100
    (( pct < 0 )) && pct=0
    local bar_w=$((w - 5))
    if (( bar_w < 3 )); then bar_w=3; fi
    local filled=$(( (pct * bar_w + 50) / 100 ))
    local empty=$((bar_w - filled))

    move_to "$row" "$col"
    printf '%b' "$C_BAR"
    local i
    for (( i = 0; i < filled; i++ )); do printf '█'; done
    printf '%b' "$C_BAR_BG"
    for (( i = 0; i < empty; i++ )); do printf '░'; done
    printf '%b %3d%%%b' "$C_WHITE" "$pct" "$C_RESET"
}

# --- USB Audio Card ---
USB_CARD=""

detect_usb_card() {
    USB_CARD=""
    if [[ -f /proc/asound/cards ]]; then
        USB_CARD=$(awk '/USB-Audio/{print $1; exit}' /proc/asound/cards)
    fi
}

# --- Audio levels ---
AUDIO_MIC=""       # percentage (integer) or ""
AUDIO_SPKR=""      # percentage (integer) or ""
AUDIO_AGC=""       # "on", "off", or ""

collect_audio() {
    AUDIO_MIC="" AUDIO_SPKR="" AUDIO_AGC=""
    [[ -n "$USB_CARD" ]] || return

    AUDIO_SPKR=$(amixer -c "$USB_CARD" get Speaker 2>/dev/null \
        | awk -F'[][]' '/Playback [0-9]/{gsub(/%/,"",$2); print $2; exit}')
    AUDIO_MIC=$(amixer -c "$USB_CARD" get Mic 2>/dev/null \
        | awk -F'[][]' '/Capture [0-9]/{gsub(/%/,"",$2); print $2; exit}')

    if amixer -c "$USB_CARD" scontrols 2>/dev/null | grep -q 'Auto Gain Control'; then
        AUDIO_AGC=$(amixer -c "$USB_CARD" get 'Auto Gain Control' 2>/dev/null \
            | awk -F'[][]' '/Capture \[/{print $2; exit}')
    fi
}

# --- Service status ---
declare -A SVC_STATUS=()

collect_services() {
    local svc
    for svc in "${SERVICES[@]}"; do
        SVC_STATUS[$svc]=$(systemctl is-active "${svc}.service" 2>/dev/null || echo "inactive")
    done
}

# --- System info ---
SYS_TEMP="" SYS_LOAD="" SYS_UPTIME="" SYS_HOST="" SYS_IP=""

collect_sysinfo() {
    local temp_file="/sys/class/thermal/thermal_zone0/temp"
    if [[ -r "$temp_file" ]]; then
        local raw
        raw=$(<"$temp_file")
        SYS_TEMP="$(( raw / 1000 ))"
    else
        SYS_TEMP=""
    fi

    SYS_LOAD=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo "")
    SYS_UPTIME=$(uptime -p 2>/dev/null | sed 's/up //;s/ days\?/d/;s/ hours\?/h/;s/ minutes\?/m/;s/,//g' || echo "")
    SYS_HOST=$(hostname -s 2>/dev/null || echo "unknown")
    SYS_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "")
}

# --- Disk usage ---
DISK_LINES=()

collect_disk() {
    DISK_LINES=()
    local line
    while IFS= read -r line; do
        DISK_LINES+=("$line")
    done < <(df -h --output=target,size,used,avail,pcent / /boot 2>/dev/null \
        | tail -n +2 \
        | awk '{gsub(/%/,"",$5); print $1, $2, $3, $4, $5}')
}

# --- USB mounts ---
USB_LINES=()

collect_usb_mounts() {
    USB_LINES=()
    local line
    while IFS= read -r line; do
        USB_LINES+=("$line")
    done < <(df -h --output=target,size,used,avail,pcent 2>/dev/null \
        | tail -n +2 \
        | awk '$1 ~ /^\/media\/|^\/mnt\// {gsub(/%/,"",$5); print $1, $2, $3, $4, $5}')
}

# --- Top processes ---
TOP_LINES=()

collect_top() {
    TOP_LINES=()
    local line
    while IFS= read -r line; do
        TOP_LINES+=("$line")
    done < <(ps -eo comm,%cpu,%mem --sort=-%cpu --no-headers 2>/dev/null \
        | head -5 \
        | awk '{printf "%s %s %s\n", $1, $2, $3}')
}

# --- Logs ---
LOG_SERVICE="svxlink"
LOG_LINES=()

collect_logs() {
    LOG_LINES=()
    local max_lines="${1:-15}"
    local line
    while IFS= read -r line; do
        LOG_LINES+=("$line")
    done < <(journalctl -u "${LOG_SERVICE}.service" --no-pager -n "$max_lines" \
        --output=short-iso 2>/dev/null)
}

# --- Refresh all data ---
refresh_all_data() {
    collect_services
    collect_sysinfo
    collect_disk
    collect_usb_mounts
    collect_top
    collect_audio
}

# --- Service picker overlay ---
PICKED_SERVICE=""

pick_service() {
    PICKED_SERVICE=""
    local prompt="${1:-Select service}"
    local sel=0
    local count=${#SERVICES[@]}

    local box_w=38 box_h=$((count + 4))
    local box_row=$(( (TERM_ROWS - box_h) / 2 ))
    local box_col=$(( (TERM_COLS - box_w) / 2 ))
    local inner_w=$((box_w - 4))

    while true; do
        clear_region "$box_row" "$box_col" "$box_w" "$box_h"
        draw_box "$box_row" "$box_col" "$box_w" "$box_h" "$prompt"

        local i
        for (( i = 0; i < count; i++ )); do
            local svc="${SERVICES[$i]}"
            local label="${SERVICE_LABELS[$svc]}"
            local status="${SVC_STATUS[$svc]:-unknown}"
            local r=$((box_row + 2 + i))
            local c=$((box_col + 2))
            local entry
            entry=$(printf ' %-14s %s' "$label" "$status")

            move_to "$r" "$c"
            if (( i == sel )); then
                printf '%b%-*s%b' "$C_BOLD$C_ACCENT" "$inner_w" "$entry" "$C_RESET"
            else
                local sc="$C_DIM"
                [[ "$status" == "active" ]] && sc="$C_OK"
                [[ "$status" == "failed" ]] && sc="$C_ERR"
                printf '%-*s' "$inner_w" ""
                move_to "$r" "$c"
                printf ' %-14s %b%-8s%b' "$label" "$sc" "$status" "$C_RESET"
            fi
        done

        read_key 300
        case "$READ_KEY_RESULT" in
            up)    (( sel > 0 )) && (( sel-- )) ;;
            down)  (( sel < count - 1 )) && (( sel++ )) ;;
            enter) PICKED_SERVICE="${SERVICES[$sel]}"; return 0 ;;
            esc|q) return 1 ;;
        esac
    done
}

# --- Result message overlay ---
show_message() {
    local title="$1" msg="$2"

    # Count lines to auto-size the box
    local msg_lines=()
    while IFS= read -r line; do
        msg_lines+=("$line")
    done <<< "$msg"
    local n_lines=${#msg_lines[@]}

    local box_w=55
    local box_h=$(( n_lines + 5 ))  # +2 top/bottom border, +1 title gap, +1 footer, +1 padding
    # Clamp to terminal size
    (( box_h > TERM_ROWS - 2 )) && box_h=$((TERM_ROWS - 2))
    local box_row=$(( (TERM_ROWS - box_h) / 2 ))
    local box_col=$(( (TERM_COLS - box_w) / 2 ))

    clear_region "$box_row" "$box_col" "$box_w" "$box_h"
    draw_box "$box_row" "$box_col" "$box_w" "$box_h" "$title"

    local inner_w=$((box_w - 4))
    local r=$((box_row + 2))
    local i
    for (( i = 0; i < ${#msg_lines[@]}; i++ )); do
        (( r >= box_row + box_h - 2 )) && break
        draw_text_trunc "$r" "$((box_col + 2))" "$inner_w" "${msg_lines[$i]}"
        (( r++ ))
    done

    move_to "$((box_row + box_h - 2))" "$((box_col + 2))"
    printf '%b%s%b' "$C_DIM" "Press any key..." "$C_RESET"
    read_key 300
}

# --- Service control actions ---

do_service_action() {
    local action="$1"
    pick_service "Select: $action" || return
    local svc="$PICKED_SERVICE"
    local output
    if output=$(systemctl "$action" "${svc}.service" 2>&1); then
        show_message "Success" "${SERVICE_LABELS[$svc]}: ${action} done"
    else
        show_message "Error" "${SERVICE_LABELS[$svc]}: ${action} failed\n${output}"
    fi
    NEEDS_REDRAW=1
}

action_start()   { do_service_action "start"; }
action_stop()    { do_service_action "stop"; }
action_restart() { do_service_action "restart"; }
action_reload()  { do_service_action "reload"; }
action_enable()  { do_service_action "enable"; }
action_disable() { do_service_action "disable"; }

# --- Config editing actions ---

action_edit_config() {
    pick_service "Edit config" || return
    local conf="${CONFIG_FILES[$PICKED_SERVICE]}"
    if [[ ! -f "$conf" ]]; then
        show_message "Error" "File not found: $conf"
        return
    fi
    exit_tui
    $EDITOR "$conf"
    enter_tui
    NEEDS_REDRAW=1
}

action_edit_gpio() {
    if [[ ! -f "$GPIO_CONF" ]]; then
        show_message "Error" "File not found: $GPIO_CONF"
        return
    fi
    exit_tui
    $EDITOR "$GPIO_CONF"
    enter_tui
    NEEDS_REDRAW=1
}

action_edit_env() {
    pick_service "Edit env" || return
    local envf="${ENV_FILES[$PICKED_SERVICE]}"
    if [[ ! -f "$envf" ]]; then
        show_message "Error" "File not found: $envf"
        return
    fi
    exit_tui
    $EDITOR "$envf"
    enter_tui
    NEEDS_REDRAW=1
}

# --- Audio action ---

action_alsamixer() {
    exit_tui
    if [[ -n "$USB_CARD" ]]; then
        alsamixer -c "$USB_CARD" || true
    else
        alsamixer || true
    fi
    enter_tui
    NEEDS_REDRAW=1
}

# --- GPIO action ---

action_gpio_restart() {
    local output
    if output=$(systemctl restart svxlink_gpio_setup.service 2>&1); then
        show_message "Success" "GPIO setup restarted"
    else
        show_message "Error" "GPIO restart failed\n${output}"
    fi
    NEEDS_REDRAW=1
}

# --- Log rotation ---

readonly LOGROTATE_CONTENT="/var/log/svxlink
/var/log/remotetrx
/var/log/svxreflector
{
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}"

action_check_logrotate() {
    local has_logs=false
    local svc
    for svc in "${SERVICES[@]}"; do
        [[ -f "${LOG_FILES[$svc]}" ]] && has_logs=true && break
    done

    if [[ "$has_logs" == false ]]; then
        show_message "Log Rotation" "No file-based logs found.\nServices log to journald only."
        return
    fi

    if ! command -v logrotate &>/dev/null; then
        show_message "Warning" "logrotate not installed.\nRun: apt install logrotate"
        return
    fi

    if [[ -f "$LOGROTATE_CONF" ]]; then
        show_message "Log Rotation OK" "Config exists: ${LOGROTATE_CONF}"
    else
        show_message "Log Rotation" "No config found. Creating..."
        echo "$LOGROTATE_CONTENT" > "$LOGROTATE_CONF"
        chmod 644 "$LOGROTATE_CONF"
        show_message "Success" "Created ${LOGROTATE_CONF}"
    fi
    NEEDS_REDRAW=1
}

# --- Health check ---

action_health_check() {
    local report=""
    report+="DISK USAGE"$'\n'
    report+="$(df -h --output=target,size,used,avail,pcent / /boot 2>/dev/null | head -5)"$'\n'
    report+=$'\n'"TOP 5 PROCESSES (CPU)"$'\n'
    report+="$(ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -6)"$'\n'
    report+=$'\n'"LOG ROTATION"$'\n'
    if [[ -f "$LOGROTATE_CONF" ]]; then
        report+="OK: ${LOGROTATE_CONF} exists"
    else
        report+="MISSING: no logrotate config"
    fi
    show_message "System Health" "$report"
    NEEDS_REDRAW=1
}
