# =============================================================================

while true; do
    main_menu || break

    choice=$(cat "$DIALOG_OUT")
    case "$choice" in
        1)  action_start ;;
        2)  action_stop ;;
        3)  action_restart ;;
        4)  action_reload ;;
        5)  action_status ;;
        6)  action_logs ;;
